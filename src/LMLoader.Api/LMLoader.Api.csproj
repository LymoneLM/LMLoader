<Project Sdk="Microsoft.NET.Sdk">

  <!-- 公共属性见根目录 Directory.Build.props -->
  <PropertyGroup>
    <PackageId>LMLoader.Api</PackageId>
    <Description>LMLoader mod API: module base class, lifecycle hooks, cross-mod services and config declaration surface. The only LMLoader reference a mod project needs.</Description>
    <PackageTags>godot;modding;mod-api;modloader</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- 模组上下文由 Core 加载器注入;契约测试需走同一条注入路径 -->
    <InternalsVisibleTo Include="LMLoader.Core" />
    <InternalsVisibleTo Include="LMLoader.Core.Tests" />
  </ItemGroup>

</Project>
