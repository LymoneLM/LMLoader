<Project Sdk="Microsoft.NET.Sdk">

  <!-- 公共属性见根目录 Directory.Build.props;GodotSharp 版本在 Directory.Packages.props(CPM) -->
  <PropertyGroup>
    <PackageId>LMLoader.GodotBridge</PackageId>
    <Description>LMLoader Godot bridge: autoload bootstrap, pck mounting in load order, SceneTree event facade.</Description>
    <PackageTags>godot;modding;mod-loader;modloader</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LMLoader.Api\LMLoader.Api.csproj" />
    <ProjectReference Include="..\LMLoader.Core\LMLoader.Core.csproj" />
    <ProjectReference Include="..\LMLoader.UI\LMLoader.UI.csproj" />
  </ItemGroup>

</Project>
