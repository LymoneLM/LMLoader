<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 仓库锁定单一包源(决策随任务 0.2):消除 NU1507,防供应链混源。
       阶段 3 若需要 BepInEx 源(nuget.bepinex.dev),在此显式添加并做 packageSourceMapping。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
