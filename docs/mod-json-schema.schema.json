{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LymoneLM/LMLoader/docs/mod-json-schema.schema.json",
  "title": "LMLoader mod.json",
  "description": "LMLoader 模组清单 v1(2026-09-27 就地重定义,决策 D18:文件级声明 + 并列模组列表,特性绑定,字段继承)。注意:本 schema 供作者侧 lint 严格校验;加载器运行时更宽容(未知字段忽略+警告)。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mods"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "清单格式主版本;加载器不识别的主版本拒载"
    },
    "mods": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/mod" }
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "description": "目标游戏标识(可选):缺省=通用模组;宿主设置 GameId 且声明了则必须匹配",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "loaderVersion": {
      "$ref": "#/definitions/versionRange",
      "description": "依赖的 LMLoader API 版本区间;缺省=当前 loader 主版本兼容区;文件级唯一,模组不可覆盖"
    },
    "version": { "$ref": "#/definitions/semver" },
    "name": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "description": { "type": "string" },
    "icon": {
      "type": "string",
      "description": "相对模组目录的图标路径",
      "pattern": "^(?!res:|file:|/|[A-Za-z]:)[^\\0]+$"
    },
    "website": { "type": "string" },
    "tags": {
      "type": "array",
      "description": "展示用标签;loader 本体不消费",
      "items": { "type": "string", "minLength": 1 }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thunderstore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "team": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$",
              "description": "Thunderstore 团队名;pack-ts 必需"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$",
              "maxLength": 128,
              "description": "Thunderstore 包名;缺省=首个模组 uid 尾段"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "reverseDomain": {
      "type": "string",
      "description": "反向域名结构唯一标识,至少两段(如 com.author.modname)",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*(\\.[a-zA-Z][a-zA-Z0-9_-]*)+$",
      "maxLength": 128
    },
    "versionRange": {
      "type": "string",
      "description": "版本区间:^ ~ >= > <= < = 精确 与 *;单声明内禁止空格/逗号组合",
      "pattern": "^(\\*|((\\^|~>?:?|>=|<=|>|<|=)?(0|[1-9]\\d*)(?:\\.(0|[1-9]\\d*))?(?:\\.(0|[1-9]\\d*))?(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?))$"
    },
    "semver": {
      "type": "string",
      "description": "SemVer 2.0.0(官方正则)",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "relativeDll": {
      "type": "string",
      "description": "相对模组目录的 .dll 文件名,禁止路径分隔符(文件级路径校验)",
      "pattern": "^[^/\\\\<>|:*?\"\\0]+\\.dll$"
    },
    "relativePath": {
      "type": "string",
      "description": "相对模组目录路径,禁止绝对路径与 .. 上跳",
      "pattern": "^(?!res:|file:|/|[A-Za-z]:)(?!.*\\.\\.)[^\\0]+$"
    },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid"],
      "properties": {
        "uid": { "$ref": "#/definitions/reverseDomain" },
        "assemblies": {
          "type": "array",
          "description": "该模组要加载的 dll 列表(相对模组目录);缺省=纯资源/依赖锚模组(无代码)",
          "items": { "$ref": "#/definitions/relativeDll" }
        },
        "pck": {
          "type": "array",
          "description": "该模组的 pck 资源包;早于一切代码加载,按模组拓扑序后挂载覆盖",
          "items": { "$ref": "#/definitions/relativePath" }
        },
        "depends": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uid"],
            "properties": {
              "uid": { "$ref": "#/definitions/reverseDomain" },
              "version": { "$ref": "#/definitions/versionRange" },
              "soft": {
                "type": "boolean",
                "default": false,
                "description": "true = 软依赖,仅约束顺序"
              }
            }
          }
        },
        "version": { "$ref": "#/definitions/semver" },
        "name": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string" },
        "icon": { "$ref": "#/definitions/relativePath" },
        "website": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
