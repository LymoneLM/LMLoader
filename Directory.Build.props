<Project>

  <!-- 所有项目共享的构建设置;项目级 csproj 只放差异项 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- 包/程序集元数据 -->
    <Version>0.1.0</Version>
    <Authors>LymoneLM</Authors>
    <Company>LymoneLM</Company>
    <Product>LMLoader</Product>
    <Copyright>Copyright (c) 2026 LymoneLM</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/LymoneLM/LMLoader</RepositoryUrl>
  </PropertyGroup>

</Project>
